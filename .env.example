# GEMINI_API_KEY: Required for server-side AI-assisted fraud & risk analysis.
GEMINI_API_KEY=

# APP_URL: Hosted URL for the application.
APP_URL=

# EXCHANGE_SANDBOX_MODE: Keep true until legal, compliance, and smart contract audits are complete.
EXCHANGE_SANDBOX_MODE=true

# MARKET_RATE_FALLBACK_INR: Fallback illustrative USDT/INR reference rate in INR when CoinGecko API is unreachable.
MARKET_RATE_FALLBACK_INR=91.85

# --- CoinGecko Market Price Integration (Server-side only) ---
# COINGECKO_API_KEY: Optional free CoinGecko Demo API key (or Pro key) for higher rate limits.
COINGECKO_API_KEY=
# COINGECKO_API_BASE_URL: https://api.coingecko.com/api/v3 (Demo/Free) or https://pro-api.coingecko.com/api/v3 (Pro).
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# --- TronGrid Blockchain Read & Testnet Monitoring (Server-side only) ---
# TRONGRID_API_KEY: Free TronGrid API key for TRON-PRO-API-KEY header on Nile/Shasta/Mainnet reads.
TRONGRID_API_KEY=
# TRONGRID_NETWORK: nile | shasta | mainnet (defaults to nile testnet in sandbox mode).
TRONGRID_NETWORK=nile
# TRONGRID_BASE_URL: Optional override (defaults to https://nile.trongrid.io for nile).
TRONGRID_BASE_URL=https://nile.trongrid.io

# --- Supabase PostgreSQL, Auth & Private Storage (Server-side only) ---
# SUPABASE_URL: Your Supabase project URL (e.g., https://your-project-ref.supabase.co).
SUPABASE_URL=
# SUPABASE_ANON_KEY: Your Supabase project anon/public key (kept server-side in this proxy architecture).
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: Secret Supabase service_role key for private KYC storage & server DB ops. Never expose in frontend!
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KYC_BUCKET: Private Supabase Storage bucket name for encrypted KYC document uploads.
SUPABASE_KYC_BUCKET=kyc-documents
