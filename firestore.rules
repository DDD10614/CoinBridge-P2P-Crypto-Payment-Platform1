rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isEmailVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'dahikardilesh@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonNegInt(v) {
      return v is int && v >= 0;
    }

    function isPosInt(v) {
      return v is int && v > 0;
    }

    function isKycVerifiedActive() {
      return isEmailVerified()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'ACTIVE'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kycStatus in ['APPROVED', 'VERIFIED']
        && (!('withdrawalLocked' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.withdrawalLocked == false)
        && (!('kycExpiresAtMs' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kycExpiresAtMs == 0
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kycExpiresAtMs > request.time.toMillis());
    }

    // --- Validation Blueprints ---
    function isValidUserAccount(d) {
      return d.keys().hasAll(['uid', 'username', 'displayName', 'role', 'kycStatus', 'accountStatus', 'completedTrades', 'completionRateBps', 'ratingAvgBps', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'username', 'displayName', 'role', 'kycStatus', 'accountStatus', 'walletAddress', 'isDemo', 'withdrawalLocked', 'restrictedReason', 'kycExpiresAtMs', 'completedTrades', 'completionRateBps', 'ratingAvgBps', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.username is string && d.username.size() >= 3 && d.username.size() <= 40 && d.username.matches('^[a-zA-Z0-9_\\-]+$')
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 80
        && d.role in ['BUYER', 'SELLER', 'MERCHANT', 'LIQUIDITY_PROVIDER', 'TREASURY_ADMIN', 'SUPPORT_AGENT', 'COMPLIANCE_OFFICER', 'ADMIN', 'SUPER_ADMIN']
        && d.kycStatus in ['NOT_STARTED', 'PENDING', 'UNDER_REVIEW', 'APPROVED', 'VERIFIED', 'REJECTED', 'ADDITIONAL_INFO_REQUIRED', 'SUSPENDED', 'EXPIRED']
        && d.accountStatus in ['ACTIVE', 'SUSPENDED', 'DELETION_REQUESTED']
        && (!('walletAddress' in d) || (d.walletAddress is string && d.walletAddress.size() <= 128))
        && (!('isDemo' in d) || d.isDemo is bool)
        && (!('withdrawalLocked' in d) || d.withdrawalLocked is bool)
        && (!('restrictedReason' in d) || (d.restrictedReason is string && d.restrictedReason.size() <= 300))
        && (!('kycExpiresAtMs' in d) || isNonNegInt(d.kycExpiresAtMs))
        && isNonNegInt(d.completedTrades)
        && isNonNegInt(d.completionRateBps) && d.completionRateBps <= 10000
        && isNonNegInt(d.ratingAvgBps) && d.ratingAvgBps <= 500
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidPrivateProfile(d) {
      return d.keys().hasAll(['uid', 'fullLegalName', 'email', 'country', 'twoFactorEnabled', 'notifyEmail', 'notifyInApp', 'notifySecurityAlerts', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'fullLegalName', 'email', 'mobile', 'country', 'residentialAddress', 'dateOfBirth', 'twoFactorEnabled', 'twoFactorMethod', 'totpSealedSecret', 'whitelistOnlyWithdrawals', 'notifyEmail', 'notifyInApp', 'notifySecurityAlerts', 'updatedAt'])
        && isValidId(d.uid)
        && d.fullLegalName is string && d.fullLegalName.size() >= 2 && d.fullLegalName.size() <= 120
        && d.email is string && d.email.size() >= 3 && d.email.size() <= 160
        && (!('mobile' in d) || (d.mobile is string && d.mobile.size() <= 24))
        && d.country is string && d.country.size() >= 2 && d.country.size() <= 64
        && (!('residentialAddress' in d) || (d.residentialAddress is string && d.residentialAddress.size() <= 300))
        && (!('dateOfBirth' in d) || (d.dateOfBirth is string && d.dateOfBirth.size() <= 20))
        && d.twoFactorEnabled is bool
        && (!('twoFactorMethod' in d) || d.twoFactorMethod in ['NONE', 'TOTP'])
        && (!('totpSealedSecret' in d) || (d.totpSealedSecret is string && d.totpSealedSecret.size() <= 512))
        && (!('whitelistOnlyWithdrawals' in d) || d.whitelistOnlyWithdrawals is bool)
        && d.notifyEmail is bool
        && d.notifyInApp is bool
        && d.notifySecurityAlerts is bool
        && d.updatedAt is timestamp;
    }

    function isValidOffer(d) {
      return d.keys().hasAll(['merchantUid', 'merchantUsername', 'verificationLevel', 'side', 'asset', 'fiatCurrency', 'rateInrPaise', 'availableUsdtMicro', 'minInrPaise', 'maxInrPaise', 'paymentMethods', 'network', 'avgCompletionMins', 'completedTrades', 'completionRateBps', 'isActive', 'isSandbox', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['merchantUid', 'merchantUsername', 'verificationLevel', 'side', 'asset', 'fiatCurrency', 'rateInrPaise', 'availableUsdtMicro', 'availableAssetE8', 'minInrPaise', 'maxInrPaise', 'paymentMethods', 'network', 'avgCompletionMins', 'completedTrades', 'completionRateBps', 'merchantRatingBps', 'merchantVolumeUsdtMicro', 'termsNote', 'isActive', 'isSandbox', 'isDemo', 'demoLabel', 'createdAt', 'updatedAt'])
        && isValidId(d.merchantUid)
        && d.merchantUsername is string && d.merchantUsername.size() >= 3 && d.merchantUsername.size() <= 40
        && d.verificationLevel in ['BASIC', 'VERIFIED', 'PREMIUM']
        && d.side in ['SELL_USDT', 'BUY_USDT', 'SELL', 'BUY']
        && d.asset is string && d.asset.size() >= 2 && d.asset.size() <= 12
        && d.fiatCurrency == 'INR'
        && isPosInt(d.rateInrPaise)
        && isNonNegInt(d.availableUsdtMicro)
        && (!('availableAssetE8' in d) || isNonNegInt(d.availableAssetE8))
        && isPosInt(d.minInrPaise)
        && isPosInt(d.maxInrPaise) && d.maxInrPaise >= d.minInrPaise
        && d.paymentMethods is list && d.paymentMethods.size() >= 1 && d.paymentMethods.size() <= 5
        && d.paymentMethods[0] is string && d.paymentMethods.hasOnly(['UPI', 'IMPS', 'NEFT', 'RTGS', 'BANK_TRANSFER'])
        && d.network in ['TRON_TRC20', 'ETHEREUM_ERC20', 'POLYGON', 'BSC', 'BITCOIN', 'SOLANA', 'XRP_LEDGER', 'DOGECOIN']
        && isPosInt(d.avgCompletionMins) && d.avgCompletionMins <= 240
        && isNonNegInt(d.completedTrades)
        && isNonNegInt(d.completionRateBps) && d.completionRateBps <= 10000
        && (!('merchantRatingBps' in d) || (isNonNegInt(d.merchantRatingBps) && d.merchantRatingBps <= 500))
        && (!('merchantVolumeUsdtMicro' in d) || isNonNegInt(d.merchantVolumeUsdtMicro))
        && (!('termsNote' in d) || (d.termsNote is string && d.termsNote.size() <= 400))
        && d.isActive is bool
        && d.isSandbox is bool
        && (!('isDemo' in d) || d.isDemo is bool)
        && (!('demoLabel' in d) || (d.demoLabel is string && d.demoLabel.size() <= 32))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidOrder(d) {
      return d.keys().hasAll(['orderCode', 'offerId', 'side', 'buyerUid', 'sellerUid', 'buyerUsername', 'sellerUsername', 'usdtMicro', 'inrPaise', 'rateInrPaise', 'feeUsdtMicro', 'tdsInrPaise', 'paymentMethod', 'network', 'escrowStatus', 'paymentMode', 'riskScore', 'riskLevel', 'status', 'isSandbox', 'expiresAtMs', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['orderCode', 'offerId', 'side', 'asset', 'buyerUid', 'sellerUid', 'buyerUsername', 'sellerUsername', 'usdtMicro', 'quantityE8', 'inrPaise', 'rateInrPaise', 'feeUsdtMicro', 'feeE8', 'tdsInrPaise', 'paymentMethod', 'network', 'buyerWalletAddress', 'sellerWalletAddress', 'paymentAccountSnapshot', 'escrowStatus', 'escrowTxHash', 'paymentRef', 'paymentMode', 'riskScore', 'riskLevel', 'status', 'buyerRating', 'releaseConfirmed2FA', 'completedAtMs', 'isSandbox', 'expiresAtMs', 'createdAt', 'updatedAt'])
        && d.orderCode is string && d.orderCode.size() >= 6 && d.orderCode.size() <= 32
        && isValidId(d.offerId)
        && d.side in ['BUY_USDT', 'SELL_USDT', 'BUY', 'SELL']
        && (!('asset' in d) || (d.asset is string && d.asset.size() >= 2 && d.asset.size() <= 12))
        && isValidId(d.buyerUid) && isValidId(d.sellerUid)
        && d.buyerUsername is string && d.buyerUsername.size() >= 2 && d.buyerUsername.size() <= 40
        && d.sellerUsername is string && d.sellerUsername.size() >= 2 && d.sellerUsername.size() <= 40
        && isPosInt(d.usdtMicro)
        && (!('quantityE8' in d) || isPosInt(d.quantityE8))
        && isPosInt(d.inrPaise)
        && isPosInt(d.rateInrPaise)
        && isNonNegInt(d.feeUsdtMicro)
        && (!('feeE8' in d) || isNonNegInt(d.feeE8))
        && isNonNegInt(d.tdsInrPaise)
        && d.paymentMethod in ['UPI', 'IMPS', 'NEFT', 'RTGS', 'BANK_TRANSFER']
        && d.network in ['TRON_TRC20', 'ETHEREUM_ERC20', 'POLYGON', 'BSC', 'BITCOIN', 'SOLANA', 'XRP_LEDGER', 'DOGECOIN']
        && (!('buyerWalletAddress' in d) || (d.buyerWalletAddress is string && d.buyerWalletAddress.size() <= 128))
        && (!('sellerWalletAddress' in d) || (d.sellerWalletAddress is string && d.sellerWalletAddress.size() <= 128))
        && (!('paymentAccountSnapshot' in d) || (d.paymentAccountSnapshot is string && d.paymentAccountSnapshot.size() <= 240))
        && d.escrowStatus in ['NONE', 'RESERVED', 'RELEASED', 'REFUNDED']
        && (!('escrowTxHash' in d) || (d.escrowTxHash is string && d.escrowTxHash.size() <= 128))
        && (!('paymentRef' in d) || (d.paymentRef is string && d.paymentRef.size() <= 128))
        && d.paymentMode in ['SANDBOX', 'PROVIDER_API']
        && isNonNegInt(d.riskScore) && d.riskScore <= 100
        && d.riskLevel in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL']
        && d.status in ['CREATED', 'AWAITING_ACCEPTANCE', 'ACCEPTED', 'ESCROW_RESERVED', 'PAYMENT_PENDING', 'PAYMENT_SUBMITTED', 'PAYMENT_VERIFIED', 'SETTLING', 'COMPLETED', 'CANCELLED', 'EXPIRED', 'DISPUTED', 'REFUNDED']
        && (!('buyerRating' in d) || (d.buyerRating is int && d.buyerRating >= 1 && d.buyerRating <= 5))
        && (!('releaseConfirmed2FA' in d) || d.releaseConfirmed2FA is bool)
        && (!('completedAtMs' in d) || isNonNegInt(d.completedAtMs))
        && d.isSandbox is bool
        && isPosInt(d.expiresAtMs)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidOrderEvent(d) {
      return d.keys().hasAll(['orderId', 'actorUid', 'action', 'fromStatus', 'toStatus', 'note', 'createdAt'])
        && d.keys().hasOnly(['orderId', 'actorUid', 'action', 'fromStatus', 'toStatus', 'note', 'createdAt'])
        && isValidId(d.orderId)
        && isValidId(d.actorUid)
        && d.action is string && d.action.size() >= 2 && d.action.size() <= 64
        && d.fromStatus is string && d.fromStatus.size() <= 32
        && d.toStatus is string && d.toStatus.size() <= 32
        && d.note is string && d.note.size() <= 400
        && d.createdAt is timestamp;
    }

    function isValidOrderMessage(d) {
      return d.keys().hasAll(['orderId', 'senderUid', 'senderUsername', 'senderRole', 'body', 'createdAt'])
        && d.keys().hasOnly(['orderId', 'senderUid', 'senderUsername', 'senderRole', 'body', 'createdAt'])
        && isValidId(d.orderId)
        && isValidId(d.senderUid)
        && d.senderUsername is string && d.senderUsername.size() >= 2 && d.senderUsername.size() <= 40
        && d.senderRole in ['BUYER', 'SELLER', 'ADMIN']
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 500
        && d.createdAt is timestamp;
    }

    function isValidKyc(d) {
      return d.keys().hasAll(['uid', 'fullLegalName', 'dateOfBirth', 'country', 'residentialAddress', 'idType', 'maskedIdNumber', 'livenessMethod', 'bankAccountLast4', 'bankIfsc', 'accountHolderName', 'pepDeclared', 'sanctionsDeclaredClear', 'sourceOfFunds', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'fullLegalName', 'dateOfBirth', 'country', 'residentialAddress', 'idType', 'maskedIdNumber', 'panMasked', 'documentExpiry', 'livenessMethod', 'videoStatus', 'videoChallengePrompt', 'livenessScore', 'faceMatchScore', 'providerMode', 'kycExpiresAtMs', 'verificationHistory', 'isDemoRecord', 'bankAccountLast4', 'bankIfsc', 'accountHolderName', 'pepDeclared', 'sanctionsDeclaredClear', 'sourceOfFunds', 'status', 'reviewerNote', 'reviewedByUid', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.fullLegalName is string && d.fullLegalName.size() >= 2 && d.fullLegalName.size() <= 120
        && d.dateOfBirth is string && d.dateOfBirth.size() >= 8 && d.dateOfBirth.size() <= 20
        && d.country is string && d.country.size() >= 2 && d.country.size() <= 64
        && d.residentialAddress is string && d.residentialAddress.size() >= 5 && d.residentialAddress.size() <= 300
        && d.idType in ['PAN', 'PASSPORT', 'AADHAAR_MASKED', 'DRIVING_LICENSE']
        && d.maskedIdNumber is string && d.maskedIdNumber.size() >= 4 && d.maskedIdNumber.size() <= 32
        && (!('panMasked' in d) || (d.panMasked is string && d.panMasked.size() <= 16))
        && (!('documentExpiry' in d) || (d.documentExpiry is string && d.documentExpiry.size() <= 20))
        && d.livenessMethod in ['SANDBOX_LIVENESS', 'PROVIDER_API', 'VIDEO_KYC_ADAPTER']
        && (!('videoStatus' in d) || d.videoStatus in ['NOT_STARTED', 'CHALLENGE_ISSUED', 'LIVENESS_PASSED', 'MANUAL_REVIEW'])
        && (!('videoChallengePrompt' in d) || (d.videoChallengePrompt is string && d.videoChallengePrompt.size() <= 240))
        && (!('livenessScore' in d) || (isNonNegInt(d.livenessScore) && d.livenessScore <= 100))
        && (!('faceMatchScore' in d) || (isNonNegInt(d.faceMatchScore) && d.faceMatchScore <= 100))
        && (!('providerMode' in d) || (d.providerMode is string && d.providerMode.size() <= 64))
        && (!('kycExpiresAtMs' in d) || isNonNegInt(d.kycExpiresAtMs))
        && (!('verificationHistory' in d) || (d.verificationHistory is list && d.verificationHistory.size() <= 15))
        && (!('isDemoRecord' in d) || d.isDemoRecord is bool)
        && d.bankAccountLast4 is string && d.bankAccountLast4.size() == 4
        && d.bankIfsc is string && d.bankIfsc.size() == 11
        && d.accountHolderName is string && d.accountHolderName.size() >= 2 && d.accountHolderName.size() <= 120
        && d.pepDeclared is bool
        && d.sanctionsDeclaredClear is bool
        && d.sourceOfFunds is string && d.sourceOfFunds.size() >= 2 && d.sourceOfFunds.size() <= 120
        && d.status in ['NOT_STARTED', 'PENDING', 'UNDER_REVIEW', 'APPROVED', 'VERIFIED', 'REJECTED', 'ADDITIONAL_INFO_REQUIRED', 'SUSPENDED', 'EXPIRED']
        && (!('reviewerNote' in d) || (d.reviewerNote is string && d.reviewerNote.size() <= 500))
        && (!('reviewedByUid' in d) || (d.reviewedByUid is string && d.reviewedByUid.size() <= 128))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidPaymentAccount(d) {
      return d.keys().hasAll(['uid', 'methodType', 'accountHolderName', 'verificationStatus', 'isActive', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'methodType', 'accountHolderName', 'bankName', 'maskedAccountNumber', 'ifsc', 'upiId', 'verificationStatus', 'isActive', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.methodType in ['UPI', 'IMPS', 'NEFT', 'RTGS', 'BANK_TRANSFER']
        && d.accountHolderName is string && d.accountHolderName.size() >= 2 && d.accountHolderName.size() <= 120
        && (!('bankName' in d) || (d.bankName is string && d.bankName.size() <= 100))
        && (!('maskedAccountNumber' in d) || (d.maskedAccountNumber is string && d.maskedAccountNumber.size() <= 32))
        && (!('ifsc' in d) || (d.ifsc is string && d.ifsc.size() <= 11))
        && (!('upiId' in d) || (d.upiId is string && d.upiId.size() <= 80))
        && d.verificationStatus in ['PENDING', 'VERIFIED', 'REJECTED']
        && d.isActive is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidPaymentRecord(d) {
      return d.keys().hasAll(['uid', 'orderId', 'orderCode', 'method', 'referenceId', 'inrPaise', 'status', 'isSandbox', 'reconciliationNote', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'orderId', 'orderCode', 'method', 'referenceId', 'inrPaise', 'status', 'isSandbox', 'reconciliationNote', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && isValidId(d.orderId)
        && d.orderCode is string && d.orderCode.size() >= 4 && d.orderCode.size() <= 32
        && d.method in ['UPI', 'IMPS', 'NEFT', 'RTGS', 'BANK_TRANSFER']
        && d.referenceId is string && d.referenceId.size() >= 6 && d.referenceId.size() <= 48
        && isPosInt(d.inrPaise)
        && d.status in ['PENDING', 'VERIFIED', 'DUPLICATE_FLAGGED', 'FAILED']
        && d.isSandbox is bool
        && d.reconciliationNote is string && d.reconciliationNote.size() <= 300
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidWalletLedger(d) {
      return d.keys().hasAll(['uid', 'availableUsdtMicro', 'reservedUsdtMicro', 'preferredNetwork', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'availableUsdtMicro', 'reservedUsdtMicro', 'connectedAddress', 'preferredNetwork', 'updatedAt'])
        && isValidId(d.uid)
        && isNonNegInt(d.availableUsdtMicro)
        && isNonNegInt(d.reservedUsdtMicro)
        && (!('connectedAddress' in d) || (d.connectedAddress is string && d.connectedAddress.size() <= 128))
        && d.preferredNetwork in ['TRON_TRC20', 'ETHEREUM_ERC20', 'POLYGON', 'BSC']
        && d.updatedAt is timestamp;
    }

    function isValidWalletTx(d) {
      return d.keys().hasAll(['uid', 'type', 'network', 'asset', 'amountMicro', 'networkFeeMicro', 'isSandbox', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'type', 'network', 'asset', 'amountMicro', 'networkFeeMicro', 'txHash', 'toAddress', 'isSandbox', 'status', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.type in ['DEPOSIT', 'WITHDRAWAL', 'ESCROW_LOCK', 'ESCROW_RELEASE', 'ESCROW_REFUND']
        && d.network in ['TRON_TRC20', 'ETHEREUM_ERC20', 'POLYGON', 'BSC']
        && d.asset == 'USDT'
        && isPosInt(d.amountMicro)
        && isNonNegInt(d.networkFeeMicro)
        && (!('txHash' in d) || (d.txHash is string && d.txHash.size() <= 128))
        && (!('toAddress' in d) || (d.toAddress is string && d.toAddress.size() <= 128))
        && d.isSandbox is bool
        && d.status in ['PENDING', 'CONFIRMING', 'CONFIRMED', 'FAILED']
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidMerchant(d) {
      return d.keys().hasAll(['uid', 'businessName', 'merchantType', 'verificationLevel', 'declaredLiquidityUsdtMicro', 'commissionBps', 'minOrderInrPaise', 'maxOrderInrPaise', 'isAvailable', 'completedOrders', 'totalVolumeUsdtMicro', 'ratingAvgBps', 'agreementAccepted', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'businessName', 'merchantType', 'verificationLevel', 'declaredLiquidityUsdtMicro', 'commissionBps', 'minOrderInrPaise', 'maxOrderInrPaise', 'isAvailable', 'isDemo', 'demoMerchantCode', 'profileBio', 'avgCompletionMins', 'disputedOrders', 'replacedByVerifiedAtMs', 'completedOrders', 'totalVolumeUsdtMicro', 'ratingAvgBps', 'vipTier', 'visibilityMode', 'showVipBadge', 'agreementAccepted', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.businessName is string && d.businessName.size() >= 2 && d.businessName.size() <= 100
        && d.merchantType in ['INDIVIDUAL', 'BUSINESS']
        && d.verificationLevel in ['BASIC', 'VERIFIED', 'PREMIUM', 'SUSPENDED']
        && isNonNegInt(d.declaredLiquidityUsdtMicro)
        && isNonNegInt(d.commissionBps) && d.commissionBps <= 1000
        && isPosInt(d.minOrderInrPaise)
        && isPosInt(d.maxOrderInrPaise) && d.maxOrderInrPaise >= d.minOrderInrPaise
        && d.isAvailable is bool
        && (!('isDemo' in d) || d.isDemo is bool)
        && (!('demoMerchantCode' in d) || (d.demoMerchantCode is string && d.demoMerchantCode.size() <= 32))
        && (!('profileBio' in d) || (d.profileBio is string && d.profileBio.size() <= 300))
        && (!('avgCompletionMins' in d) || isNonNegInt(d.avgCompletionMins))
        && (!('disputedOrders' in d) || isNonNegInt(d.disputedOrders))
        && (!('replacedByVerifiedAtMs' in d) || isNonNegInt(d.replacedByVerifiedAtMs))
        && isNonNegInt(d.completedOrders)
        && isNonNegInt(d.totalVolumeUsdtMicro)
        && isNonNegInt(d.ratingAvgBps) && d.ratingAvgBps <= 500
        && (!('vipTier' in d) || d.vipTier in ['BRONZE', 'SILVER', 'GOLD', 'PLATINUM'])
        && (!('visibilityMode' in d) || d.visibilityMode in ['PUBLIC', 'HIGH_VOLUME_ONLY', 'HIDDEN'])
        && (!('showVipBadge' in d) || d.showVipBadge is bool)
        && d.agreementAccepted is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidDispute(d) {
      return d.keys().hasAll(['orderId', 'orderCode', 'raisedByUid', 'counterpartyUid', 'category', 'description', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['orderId', 'orderCode', 'raisedByUid', 'counterpartyUid', 'category', 'description', 'paymentRef', 'evidenceSummary', 'evidenceItems', 'escalatedToCompliance', 'escalatedAtMs', 'status', 'assignedOfficerUid', 'resolutionNote', 'createdAt', 'updatedAt'])
        && isValidId(d.orderId)
        && d.orderCode is string && d.orderCode.size() >= 4 && d.orderCode.size() <= 32
        && isValidId(d.raisedByUid) && isValidId(d.counterpartyUid)
        && d.category in ['PAYMENT_NOT_RECEIVED', 'PAYMENT_NOT_ACKNOWLEDGED', 'INCORRECT_AMOUNT', 'SELLER_NOT_RELEASING', 'BUYER_NOT_PAYING', 'SUSPICIOUS_TRANSACTION', 'DUPLICATE_PAYMENT', 'OTHER']
        && d.description is string && d.description.size() >= 10 && d.description.size() <= 1000
        && (!('paymentRef' in d) || (d.paymentRef is string && d.paymentRef.size() <= 128))
        && (!('evidenceSummary' in d) || (d.evidenceSummary is string && d.evidenceSummary.size() <= 600))
        && (!('evidenceItems' in d) || (d.evidenceItems is list && d.evidenceItems.size() <= 6))
        && (!('escalatedToCompliance' in d) || d.escalatedToCompliance is bool)
        && (!('escalatedAtMs' in d) || isNonNegInt(d.escalatedAtMs))
