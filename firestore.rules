    function isValidCoinTradingSettings(d) {
      return d.keys().hasAll(['symbol', 'tradingEnabled', 'depositEnabled', 'withdrawalEnabled', 'custodyApproved', 'minTradeQuantityE8', 'maxTradeQuantityE8', 'tradingFeeBps', 'confirmationsRequired', 'updatedAt'])
        && d.keys().hasOnly(['symbol', 'tradingEnabled', 'depositEnabled', 'withdrawalEnabled', 'custodyApproved', 'minTradeQuantityE8', 'maxTradeQuantityE8', 'tradingFeeBps', 'confirmationsRequired', 'updatedByUid', 'updatedAt'])
        && d.symbol is string && d.symbol.size() >= 2 && d.symbol.size() <= 12
        && d.tradingEnabled is bool
        && d.depositEnabled is bool
        && d.withdrawalEnabled is bool
        && d.custodyApproved is bool
        && isPosInt(d.minTradeQuantityE8)
        && isPosInt(d.maxTradeQuantityE8) && d.maxTradeQuantityE8 >= d.minTradeQuantityE8
        && isNonNegInt(d.tradingFeeBps) && d.tradingFeeBps <= 1000
        && isPosInt(d.confirmationsRequired)
        && (!('updatedByUid' in d) || (d.updatedByUid is string && d.updatedByUid.size() <= 128))
        && d.updatedAt is timestamp;
    }

    function isValidCoinWatchlist(d) {
      return d.keys().hasAll(['uid', 'symbol', 'createdAt'])
        && d.keys().hasOnly(['uid', 'symbol', 'createdAt'])
        && isValidId(d.uid)
        && d.symbol is string && d.symbol.size() >= 2 && d.symbol.size() <= 12
        && d.createdAt is timestamp;
    }

    function isValidCoinPriceAlert(d) {
      return d.keys().hasAll(['uid', 'symbol', 'targetInrPaise', 'condition', 'isActive', 'triggered', 'createdAt'])
        && d.keys().hasOnly(['uid', 'symbol', 'targetInrPaise', 'condition', 'isActive', 'triggered', 'lastTriggeredAtMs', 'createdAt'])
        && isValidId(d.uid)
        && d.symbol is string && d.symbol.size() >= 2 && d.symbol.size() <= 12
        && isPosInt(d.targetInrPaise)
        && d.condition in ['ABOVE', 'BELOW']
        && d.isActive is bool
        && d.triggered is bool
        && (!('lastTriggeredAtMs' in d) || isNonNegInt(d.lastTriggeredAtMs))
        && d.createdAt is timestamp;
    }

    function isValidMultiCoinOrder(d) {
      return d.keys().hasAll(['orderId', 'orderCode', 'symbol', 'side', 'buyerUid', 'sellerUid', 'quantityE8', 'rateInrPaise', 'inrPaise', 'feeE8', 'network', 'status', 'isSandbox', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['orderId', 'orderCode', 'symbol', 'side', 'buyerUid', 'sellerUid', 'quantityE8', 'rateInrPaise', 'inrPaise', 'feeE8', 'network', 'status', 'isSandbox', 'createdAt', 'updatedAt'])
        && isValidId(d.orderId)
        && d.orderCode is string && d.orderCode.size() >= 6 && d.orderCode.size() <= 32
        && d.symbol is string && d.symbol.size() >= 2 && d.symbol.size() <= 12
        && d.side in ['BUY', 'SELL']
        && isValidId(d.buyerUid) && isValidId(d.sellerUid)
        && isPosInt(d.quantityE8)
        && isPosInt(d.rateInrPaise)
        && isPosInt(d.inrPaise)
        && isNonNegInt(d.feeE8)
        && d.network in ['TRON_TRC20', 'ETHEREUM_ERC20', 'POLYGON', 'BSC', 'BITCOIN', 'SOLANA', 'XRP_LEDGER', 'DOGECOIN']
        && d.status in ['CREATED', 'AWAITING_ACCEPTANCE', 'ACCEPTED', 'ESCROW_RESERVED', 'PAYMENT_PENDING', 'PAYMENT_SUBMITTED', 'PAYMENT_VERIFIED', 'SETTLING', 'COMPLETED', 'CANCELLED', 'EXPIRED', 'DISPUTED', 'REFUNDED']
        && d.isSandbox is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidPriceLock(d) {
      return d.keys().hasAll(['lockId', 'uid', 'offerId', 'asset', 'side', 'rateInrPaise', 'ttlSeconds', 'expiresAtMs', 'signature', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['lockId', 'uid', 'offerId', 'asset', 'side', 'rateInrPaise', 'ttlSeconds', 'expiresAtMs', 'signature', 'status', 'createdAt', 'updatedAt'])
        && d.lockId is string && d.lockId.size() >= 6 && d.lockId.size() <= 64
        && isValidId(d.uid)
        && isValidId(d.offerId)
        && d.asset is string && d.asset.size() >= 2 && d.asset.size() <= 12
        && d.side in ['BUY', 'SELL']
        && isPosInt(d.rateInrPaise)
        && isPosInt(d.ttlSeconds) && d.ttlSeconds <= 600
        && isPosInt(d.expiresAtMs)
        && d.signature is string && d.signature.size() >= 32 && d.signature.size() <= 128
        && d.status in ['LOCKED', 'CONSUMED', 'EXPIRED']
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidSupportMessage(d) {
      return d.keys().hasAll(['ticketId', 'senderUid', 'senderName', 'senderRole', 'body', 'createdAt'])
        && d.keys().hasOnly(['ticketId', 'senderUid', 'senderName', 'senderRole', 'body', 'createdAt'])
        && isValidId(d.ticketId)
        && isValidId(d.senderUid)
        && d.senderName is string && d.senderName.size() >= 2 && d.senderName.size() <= 80
        && d.senderRole in ['USER', 'SUPPORT', 'ADMIN']
        && d.body is string && d.body.size() >= 1 && d.body.size() <= 1000
        && d.createdAt is timestamp;
    }

    function isValidMerchantApiKey(d) {
      return d.keys().hasAll(['uid', 'keyHash', 'keyPrefix', 'label', 'scopes', 'rateLimitPerMin', 'revoked', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'keyHash', 'keyPrefix', 'label', 'scopes', 'rateLimitPerMin', 'revoked', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.keyHash is string && d.keyHash.size() == 64
        && d.keyPrefix is string && d.keyPrefix.size() >= 8 && d.keyPrefix.size() <= 32
        && d.label is string && d.label.size() >= 2 && d.label.size() <= 64
        && d.scopes is list && d.scopes.size() >= 1 && d.scopes.size() <= 8
        && isPosInt(d.rateLimitPerMin) && d.rateLimitPerMin <= 600
        && d.revoked is bool
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidMerchantWebhook(d) {
      return d.keys().hasAll(['uid', 'url', 'events', 'secretMasked', 'isActive', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['uid', 'url', 'events', 'secretMasked', 'isActive', 'lastTestStatus', 'createdAt', 'updatedAt'])
        && isValidId(d.uid)
        && d.url is string && d.url.size() >= 10 && d.url.size() <= 300 && d.url.matches('^https://.*')
        && d.events is list && d.events.size() >= 1 && d.events.size() <= 10
        && d.secretMasked is string && d.secretMasked.size() >= 6 && d.secretMasked.size() <= 40
        && d.isActive is bool
        && (!('lastTestStatus' in d) || (d.lastTestStatus is string && d.lastTestStatus.size() <= 120))
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function isValidMaintenanceWindow(d) {
      return d.keys().hasAll(['title', 'description', 'affectedServices', 'status', 'scheduledStartIso', 'scheduledEndIso', 'createdByUid', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['title', 'description', 'affectedServices', 'status', 'scheduledStartIso', 'scheduledEndIso', 'createdByUid', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 3 && d.title.size() <= 120
        && d.description is string && d.description.size() >= 5 && d.description.size() <= 500
        && d.affectedServices is list && d.affectedServices.size() >= 1 && d.affectedServices.size() <= 10
        && d.status in ['SCHEDULED', 'IN_PROGRESS', 'COMPLETED']
        && d.scheduledStartIso is string && d.scheduledStartIso.size() >= 10 && d.scheduledStartIso.size() <= 40
        && d.scheduledEndIso is string && d.scheduledEndIso.size() >= 10 && d.scheduledEndIso.size() <= 40
        && isValidId(d.createdByUid)
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    // --- Connection Probe ---
    match /test/connection {
      allow get: if true;
    }

    // --- Admin Registry ---
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // --- Platform Settings (Public Read, Admin Write) ---
    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isValidId(settingId) && isAdmin() && isValidPlatformSettings(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Users (Public-safe account summary) ---
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isEmailVerified()
        && isValidUserAccount(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role in ['BUYER', 'SELLER', 'MERCHANT']
        && incoming().kycStatus == 'NOT_STARTED'
        && incoming().accountStatus == 'ACTIVE'
        && incoming().completedTrades == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isEmailVerified() && isValidUserAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().role in ['BUYER', 'SELLER', 'MERCHANT']
            && incoming().kycStatus == existing().kycStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'displayName', 'walletAddress', 'role', 'accountStatus', 'withdrawalLocked', 'restrictedReason', 'updatedAt'])
          )
        );
      allow delete: if false;

      // --- Split Collection for PII ---
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow create, update: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin())
          && isEmailVerified()
          && isValidPrivateProfile(incoming())
          && incoming().uid == userId
          && incoming().updatedAt == request.time;
        allow delete: if false;
      }
    }

    // --- Marketplace P2P Offers ---
    match /p2p_offers/{offerId} {
      allow get: if isValidId(offerId) && (existing().isActive == true || isOwner(existing().merchantUid) || isAdmin());
      allow list: if resource.data.isActive == true || (isSignedIn() && resource.data.merchantUid == request.auth.uid) || isAdmin();
      allow create: if isValidId(offerId) && isEmailVerified() && isValidOffer(incoming())
        && (isAdmin() || (
          isKycVerifiedActive()
          && incoming().merchantUid == request.auth.uid
          && incoming().verificationLevel == 'BASIC'
          && (!('isDemo' in incoming()) || incoming().isDemo == false)
        ))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(offerId) && isEmailVerified() && isValidOffer(incoming())
        && incoming().merchantUid == existing().merchantUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().merchantUid)
            && incoming().verificationLevel == existing().verificationLevel
            && incoming().diff(existing()).affectedKeys().hasOnly(['rateInrPaise', 'availableUsdtMicro', 'availableAssetE8', 'minInrPaise', 'maxInrPaise', 'paymentMethods', 'network', 'avgCompletionMins', 'termsNote', 'isActive', 'updatedAt'])
          )
        );
      allow delete: if isValidId(offerId) && isAdmin();
    }

    // --- P2P Orders, Audit Events, & Counterparty Chat ---
    match /p2p_orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().buyerUid == request.auth.uid || existing().sellerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isEmailVerified() && isValidOrder(incoming())
        && (isAdmin() || isKycVerifiedActive())
        && (incoming().buyerUid == request.auth.uid || incoming().sellerUid == request.auth.uid)
        && incoming().buyerUid != incoming().sellerUid
        && incoming().status in ['CREATED', 'AWAITING_ACCEPTANCE']
        && incoming().escrowStatus == 'NONE'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/p2p_offers/$(incoming().offerId));
      allow update: if isValidId(orderId) && isEmailVerified() && isValidOrder(incoming())
        && incoming().orderCode == existing().orderCode
        && incoming().offerId == existing().offerId
        && incoming().side == existing().side
        && incoming().buyerUid == existing().buyerUid
        && incoming().sellerUid == existing().sellerUid
        && incoming().usdtMicro == existing().usdtMicro
        && incoming().inrPaise == existing().inrPaise
        && incoming().rateInrPaise == existing().rateInrPaise
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            (isKycVerifiedActive() || incoming().status in ['CANCELLED', 'EXPIRED', 'DISPUTED'] || incoming().status == existing().status) && (
            // Allow buyer to submit a one-time rating on completed orders
            (isOwner(existing().buyerUid)
              && existing().status == 'COMPLETED'
              && !('buyerRating' in existing())
              && incoming().status == 'COMPLETED'
              && incoming().escrowStatus == existing().escrowStatus
              && incoming().diff(existing()).affectedKeys().hasOnly(['buyerRating', 'updatedAt'])) ||
            (!(existing().status in ['COMPLETED', 'CANCELLED', 'EXPIRED', 'REFUNDED']) && (
              // Allow buyer or seller to expire an overdue pre-settlement order
              ((isOwner(existing().buyerUid) || isOwner(existing().sellerUid))
                && request.time.toMillis() > existing().expiresAtMs
                && existing().status in ['CREATED', 'AWAITING_ACCEPTANCE', 'ACCEPTED', 'ESCROW_RESERVED', 'PAYMENT_PENDING']
                && incoming().status == 'EXPIRED'
                && incoming().escrowStatus in ['NONE', 'REFUNDED']
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'escrowStatus', 'updatedAt'])) ||
              // Buyer actions: submit payment ref, cancel pre-payment, or open dispute
              (isOwner(existing().buyerUid)
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentRef', 'buyerWalletAddress', 'paymentAccountSnapshot', 'updatedAt'])
                && (
                  (existing().status in ['ACCEPTED', 'ESCROW_RESERVED', 'PAYMENT_PENDING'] && incoming().status == 'PAYMENT_SUBMITTED') ||
                  (existing().status in ['CREATED', 'AWAITING_ACCEPTANCE', 'ACCEPTED', 'PAYMENT_PENDING'] && incoming().status == 'CANCELLED') ||
                  (existing().status in ['PAYMENT_SUBMITTED', 'PAYMENT_VERIFIED', 'SETTLING'] && incoming().status == 'DISPUTED') ||
                  (incoming().status == existing().status)
                )) ||
              // Seller actions: accept, reserve escrow, verify payment & release, cancel pre-payment, or dispute
              (isOwner(existing().sellerUid)
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'escrowStatus', 'escrowTxHash', 'sellerWalletAddress', 'paymentAccountSnapshot', 'releaseConfirmed2FA', 'completedAtMs', 'updatedAt'])
                && (
                  (existing().status in ['CREATED', 'AWAITING_ACCEPTANCE'] && incoming().status in ['ACCEPTED', 'CANCELLED']) ||
                  (existing().status in ['CREATED', 'AWAITING_ACCEPTANCE', 'ACCEPTED'] && incoming().status in ['ESCROW_RESERVED', 'PAYMENT_PENDING'] && incoming().escrowStatus == 'RESERVED') ||
                  (existing().status in ['PAYMENT_SUBMITTED', 'PAYMENT_VERIFIED', 'SETTLING'] && incoming().status in ['PAYMENT_VERIFIED', 'SETTLING', 'COMPLETED'] && incoming().escrowStatus in ['RESERVED', 'RELEASED']) ||
                  (existing().status in ['PAYMENT_SUBMITTED', 'PAYMENT_VERIFIED', 'SETTLING'] && incoming().status == 'DISPUTED') ||
                  (incoming().status == existing().status)
                ))
            ))
          ))
        );
      allow delete: if false;

      match /events/{eventId} {
        allow get: if isValidId(orderId) && isValidId(eventId) && isSignedIn() && (
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.sellerUid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isValidId(orderId) && isSignedIn() && (
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.sellerUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isValidId(orderId) && isValidId(eventId) && isEmailVerified()
          && isValidOrderEvent(incoming())
          && incoming().orderId == orderId
          && incoming().actorUid == request.auth.uid
          && incoming().createdAt == request.time
          && (
            get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.buyerUid == request.auth.uid ||
            get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.sellerUid == request.auth.uid ||
            isAdmin()
          );
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow get: if isValidId(orderId) && isValidId(messageId) && isSignedIn() && (
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.sellerUid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isValidId(orderId) && isSignedIn() && (
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.buyerUid == request.auth.uid ||
          get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.sellerUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isValidId(orderId) && isValidId(messageId) && isEmailVerified()
          && isValidOrderMessage(incoming())
          && incoming().orderId == orderId
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time
          && (
            get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.buyerUid == request.auth.uid ||
            get(/databases/$(database)/documents/p2p_orders/$(orderId)).data.sellerUid == request.auth.uid ||
            isAdmin()
          );
        allow update, delete: if false;
      }
    }

    // --- KYC Submissions (Owner or Admin/Compliance Only) ---
    match /kyc_submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(submissionId) && isEmailVerified() && isValidKyc(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'PENDING'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(submissionId) && isEmailVerified() && isValidKyc(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().uid)
            && existing().status in ['NOT_STARTED', 'REJECTED', 'ADDITIONAL_INFO_REQUIRED', 'EXPIRED']
            && incoming().status == 'PENDING'
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullLegalName', 'dateOfBirth', 'country', 'residentialAddress', 'idType', 'maskedIdNumber', 'panMasked', 'documentExpiry', 'livenessMethod', 'videoStatus', 'videoChallengePrompt', 'livenessScore', 'faceMatchScore', 'providerMode', 'kycExpiresAtMs', 'verificationHistory', 'bankAccountLast4', 'bankIfsc', 'accountHolderName', 'pepDeclared', 'sanctionsDeclaredClear', 'sourceOfFunds', 'status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // --- Payment Accounts (Strictly Owner or Admin) ---
    match /payment_accounts/{accountId} {
      allow get: if isValidId(accountId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(accountId) && isEmailVerified() && isValidPaymentAccount(incoming())
        && incoming().uid == request.auth.uid
        && incoming().verificationStatus == 'PENDING'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(accountId) && isEmailVerified() && isValidPaymentAccount(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().uid)
            && incoming().verificationStatus == existing().verificationStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'updatedAt'])
          )
        );
      allow delete: if isValidId(accountId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Payment Reconciliation Records ---
    match /payment_records/{recordId} {
      allow get: if isValidId(recordId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(recordId) && isEmailVerified() && isValidPaymentRecord(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(recordId) && isAdmin() && isValidPaymentRecord(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Wallets & Transactions ---
    match /wallets/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isEmailVerified()
        && isValidWalletLedger(incoming())
        && incoming().uid == request.auth.uid
        && incoming().availableUsdtMicro == 0
        && incoming().reservedUsdtMicro == 0
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isEmailVerified() && isValidWalletLedger(incoming())
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(userId)
            && incoming().diff(existing()).affectedKeys().hasOnly(['connectedAddress', 'preferredNetwork', 'availableUsdtMicro', 'reservedUsdtMicro', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /wallet_transactions/{txId} {
      allow get: if isValidId(txId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(txId) && isEmailVerified() && isValidWalletTx(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(txId) && isAdmin() && isValidWalletTx(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Merchants ---
    match /merchants/{merchantId} {
      allow get: if isValidId(merchantId);
      allow list: if true;
      allow create: if isValidId(merchantId) && isEmailVerified() && isValidMerchant(incoming())
        && (isAdmin() || (
          isKycVerifiedActive()
          && incoming().uid == request.auth.uid
          && incoming().verificationLevel == 'BASIC'
          && (!('isDemo' in incoming()) || incoming().isDemo == false)
          && incoming().completedOrders == 0
          && incoming().totalVolumeUsdtMicro == 0
        ))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(merchantId) && isEmailVerified() && isValidMerchant(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().uid)
            && incoming().verificationLevel == existing().verificationLevel
            && incoming().commissionBps == existing().commissionBps
            && incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'profileBio', 'declaredLiquidityUsdtMicro', 'minOrderInrPaise', 'maxOrderInrPaise', 'isAvailable', 'visibilityMode', 'showVipBadge', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // --- Disputes ---
    match /disputes/{disputeId} {
      allow get: if isValidId(disputeId) && isSignedIn() && (existing().raisedByUid == request.auth.uid || existing().counterpartyUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.raisedByUid == request.auth.uid || resource.data.counterpartyUid == request.auth.uid || isAdmin());
      allow create: if isValidId(disputeId) && isEmailVerified() && isValidDispute(incoming())
        && incoming().raisedByUid == request.auth.uid
        && incoming().status == 'OPEN'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/p2p_orders/$(incoming().orderId));
      allow update: if isValidId(disputeId) && isEmailVerified() && isValidDispute(incoming())
        && incoming().orderId == existing().orderId
        && incoming().raisedByUid == existing().raisedByUid
        && incoming().counterpartyUid == existing().counterpartyUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            !(existing().status in ['RESOLVED', 'REJECTED'])
            && (isOwner(existing().raisedByUid) || isOwner(existing().counterpartyUid))
            && incoming().status in [existing().status, 'ESCALATED']
            && incoming().diff(existing()).affectedKeys().hasOnly(['evidenceSummary', 'evidenceItems', 'paymentRef', 'status', 'escalatedToCompliance', 'escalatedAtMs', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // --- Risk Assessments ---
    match /risk_assessments/{assessmentId} {
      allow get: if isValidId(assessmentId) && isSignedIn() && (existing().subjectUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.subjectUid == request.auth.uid || isAdmin());
      allow create: if isValidId(assessmentId) && isEmailVerified() && isValidRiskAssessment(incoming())
        && (isAdmin() || (incoming().subjectUid == request.auth.uid && incoming().humanDecision == 'PENDING_REVIEW'))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(assessmentId) && isAdmin() && isValidRiskAssessment(incoming())
        && incoming().subjectUid == existing().subjectUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Support Tickets & Live Support Chat ---
    match /support_tickets/{ticketId} {
      allow get: if isValidId(ticketId) && ((isSignedIn() && existing().uid == request.auth.uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(ticketId) && isValidSupportTicket(incoming())
        && incoming().status == 'OPEN'
        && (!('uid' in incoming()) || (isSignedIn() && incoming().uid == request.auth.uid))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(ticketId) && isAdmin() && isValidSupportTicket(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isValidId(ticketId) && isValidId(messageId) && isSignedIn() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isValidId(ticketId) && isSignedIn() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isValidId(ticketId) && isValidId(messageId) && isEmailVerified()
          && isValidSupportMessage(incoming())
          && incoming().ticketId == ticketId
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time
          && (
            get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.uid == request.auth.uid ||
            isAdmin()
          );
        allow update, delete: if false;
      }
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(notificationId) && isEmailVerified() && isValidNotification(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update: if isValidId(notificationId) && isEmailVerified() && isValidNotification(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // --- Security Sessions / Device Management ---
    match /security_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(sessionId) && isEmailVerified() && isValidSecuritySession(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().lastActiveAt == request.time;
      allow update: if isValidId(sessionId) && isEmailVerified() && isValidSecuritySession(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().lastActiveAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().uid)
            && incoming().diff(existing()).affectedKeys().hasOnly(['trusted', 'revoked', 'suspicious', 'suspiciousReason', 'lastActiveAt'])
          )
        );
      allow delete: if false;
    }

    // --- Withdrawal Whitelist ---
    match /withdrawal_whitelist/{entryId} {
      allow get: if isValidId(entryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(entryId) && isEmailVerified() && isValidWithdrawalWhitelist(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(entryId) && isEmailVerified() && isValidWithdrawalWhitelist(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'label', 'updatedAt']);
      allow delete: if isValidId(entryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Price Alerts ---
    match /price_alerts/{alertId} {
      allow get: if isValidId(alertId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(alertId) && isEmailVerified() && isValidPriceAlert(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(alertId) && isEmailVerified() && isValidPriceAlert(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'triggered', 'lastTriggeredAtMs']);
      allow delete: if isValidId(alertId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Compliance Cases (Admin / Compliance Officer Only) ---
    match /compliance_cases/{caseId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(caseId) && isAdmin() && isValidComplianceCase(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(caseId) && isAdmin() && isValidComplianceCase(incoming())
        && incoming().subjectUid == existing().subjectUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Reviews / Approved Testimonials ---
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().approved == true || isOwner(existing().authorUid) || isAdmin());
      allow list: if resource.data.approved == true || (isSignedIn() && resource.data.authorUid == request.auth.uid) || isAdmin();
      allow create: if isValidId(reviewId) && isEmailVerified() && isValidReview(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().approved == false
        && incoming().createdAt == request.time;
      allow update: if isValidId(reviewId) && isAdmin() && isValidReview(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // --- Immutable Audit Logs ---
    match /audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isEmailVerified() && isValidAuditLog(incoming())
        && (isAdmin() || incoming().actorUid == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- Deterministic Deposit Addresses ---
    match /wallet_addresses/{addressId} {
      allow get: if isValidId(addressId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(addressId) && isEmailVerified() && isValidWalletAddressDoc(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- Supported Networks & Token Contracts ---
    match /supported_networks/{networkId} {
      allow get, list: if true;
      allow create, update: if isValidId(networkId) && isAdmin() && isValidSupportedNetwork(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /supported_tokens/{tokenId} {
      allow get, list: if true;
      allow create, update: if isValidId(tokenId) && isAdmin() && isValidSupportedToken(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Wallet Security Policy ---
    match /wallet_security_settings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(settingId) && isAdmin() && isValidWalletSecuritySettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Idempotent Blockchain Events ---
    match /blockchain_events/{eventId} {
      allow get: if isValidId(eventId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(eventId) && isEmailVerified() && isValidBlockchainEvent(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- USDT Deposit Transactions ---
    match /deposit_transactions/{depositId} {
      allow get: if isValidId(depositId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(depositId) && isEmailVerified() && isValidDepositTx(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(depositId) && isAdmin() && isValidDepositTx(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- USDT Withdrawal Transactions ---
    match /withdrawal_transactions/{withdrawalId} {
      allow get: if isValidId(withdrawalId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(withdrawalId) && isEmailVerified() && isValidWithdrawalTx(incoming())
        && (isAdmin() || (isKycVerifiedActive() && incoming().uid == request.auth.uid && incoming().twoFactorVerified == true && incoming().status in ['PENDING', 'UNDER_REVIEW', 'PROCESSING']))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(withdrawalId) && isAdmin() && isValidWithdrawalTx(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- Double-Entry Immutable Wallet Ledger ---
    match /wallet_ledger/{entryId} {
      allow get: if isValidId(entryId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(entryId) && isEmailVerified() && isValidWalletLedgerEntry(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- Escrow & Pending Withdrawal Balance Reservations ---
    match /wallet_reservations/{reservationId} {
      allow get: if isValidId(reservationId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(reservationId) && isEmailVerified() && isValidWalletReservation(incoming())
        && (isAdmin() || incoming().uid == request.auth.uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(reservationId) && isEmailVerified() && isValidWalletReservation(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            isOwner(existing().uid)
            && existing().purpose == 'P2P_ESCROW'
            && existing().status == 'ACTIVE'
            && incoming().status in ['RELEASED', 'REFUNDED']
          )
        );
      allow delete: if false;
    }

    // --- Immutable Wallet & Trading Access Audit Logs ---
    match /wallet_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId) && isEmailVerified() && isValidWalletAuditLog(incoming())
        && (isAdmin() || incoming().actorUid == request.auth.uid)
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // --- Multi-Coin Registry & Trading Controls ---
    match /supported_coins/{coinId} {
      allow get, list: if true;
      allow create, update: if isValidId(coinId) && isAdmin() && isValidSupportedCoin(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /coin_trading_settings/{coinId} {
      allow get, list: if true;
      allow create, update: if isValidId(coinId) && isAdmin() && isValidCoinTradingSettings(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /coin_market_data/{coinId} {
      allow get, list: if true;
      allow create, update: if isValidId(coinId) && isAdmin() && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /coin_price_history/{historyId} {
      allow get, list: if true;
      allow create, update: if isValidId(historyId) && isAdmin() && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /coin_market_cache/{cacheId} {
      allow get, list: if true;
      allow create, update: if isValidId(cacheId) && isAdmin() && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // --- User Coin Watchlists ---
    match /coin_watchlists/{watchId} {
      allow get: if isValidId(watchId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(watchId) && isEmailVerified() && isValidCoinWatchlist(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(watchId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Multi-Coin Target Price Alerts ---
    match /coin_price_alerts/{alertId} {
      allow get: if isValidId(alertId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(alertId) && isEmailVerified() && isValidCoinPriceAlert(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(alertId) && isEmailVerified() && isValidCoinPriceAlert(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().symbol == existing().symbol
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['isActive', 'triggered', 'lastTriggeredAtMs']);
      allow delete: if isValidId(alertId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Multi-Coin Order Ledger ---
    match /multi_coin_orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().buyerUid == request.auth.uid || existing().sellerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isAdmin());
      allow create: if isValidId(orderId) && isEmailVerified() && isValidMultiCoinOrder(incoming())
        && (isAdmin() || isKycVerifiedActive())
        && (incoming().buyerUid == request.auth.uid || incoming().sellerUid == request.auth.uid)
        && incoming().buyerUid != incoming().sellerUid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId) && isEmailVerified() && isValidMultiCoinOrder(incoming())
        && incoming().orderId == existing().orderId
        && incoming().buyerUid == existing().buyerUid
        && incoming().sellerUid == existing().sellerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || isOwner(existing().buyerUid) || isOwner(existing().sellerUid));
      allow delete: if false;
    }

    // --- Temporary Rate Price Locks ---
    match /price_locks/{lockId} {
      allow get: if isValidId(lockId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(lockId) && isEmailVerified() && isValidPriceLock(incoming())
        && incoming().uid == request.auth.uid
        && incoming().status == 'LOCKED'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(lockId) && isEmailVerified() && isValidPriceLock(incoming())
        && isOwner(existing().uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // --- Merchant API Keys (SHA-256 Hashes Only) ---
    match /merchant_api_keys/{keyId} {
      allow get: if isValidId(keyId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(keyId) && isEmailVerified() && isValidMerchantApiKey(incoming())
        && isKycVerifiedActive()
        && incoming().uid == request.auth.uid
        && incoming().revoked == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(keyId) && isEmailVerified() && isValidMerchantApiKey(incoming())
        && (isAdmin() || isOwner(existing().uid))
        && incoming().uid == existing().uid
        && incoming().keyHash == existing().keyHash
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['revoked', 'label', 'updatedAt']);
      allow delete: if false;
    }

    // --- Merchant HTTPS Webhooks ---
    match /merchant_webhooks/{webhookId} {
      allow get: if isValidId(webhookId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isValidId(webhookId) && isEmailVerified() && isValidMerchantWebhook(incoming())
        && isKycVerifiedActive()
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(webhookId) && isEmailVerified() && isValidMerchantWebhook(incoming())
        && (isAdmin() || isOwner(existing().uid))
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(webhookId) && isSignedIn() && (existing().uid == request.auth.uid || isAdmin());
    }

    // --- Public System Maintenance Windows ---
    match /system_maintenance/{windowId} {
      allow get, list: if true;
      allow create, update: if isValidId(windowId) && isAdmin() && isValidMaintenanceWindow(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(windowId) && isAdmin();
    }
  }
}
